# The data is written in the driver's assembly form (see the driver for
# details). The fixed codes for the symbols we use are:
#
# 'a'  c10010001    256  c0000000    260  c0000100    284  c11000100
# 'b'  c10010010    257  c0000001    263  c0000111    285  c11000101
# 'c'  c10010011                                      286  c11000110
# '!'  c01010001
#
# And the fixed distance code is the 5-bit symbol (c00000 is distance 1,
# c00010 is distance 3).

: stored
: Test stored blocks
:
{{
  : text
  :
  $* <'1:1 2:0 align 16:5 16:65530 x68656c6c6f' >:'hello'

  : empty
  :
  $* <'1:1 2:0 align 16:0 16:65535' >:''

  : padding
  : Stored block whose header is padded with non-zero bits, which are
  : ignored
  :
  $* <'1:1 2:0 5:31 16:5 16:65530 x68656c6c6f' >:'hello'

  : complement
  : Stored block length that does not match its complement
  :
  $* <'1:1 2:0 align 16:5 16:0 x68656c6c6f' 2>>EOE != 0
  error: invalid stored block length complement 0 for length 5
  EOE
}}

: fixed
: Test blocks compressed with the fixed codes
:
{{
  : literals
  :
  $* <'1:1 2:1 c10010001 c10010010 c10010011 c0000000' >:'abc'

  : match
  :
  $* <<EOI >:'abcabcabc'
  1:1 2:1 c10010001 c10010010 c10010011
  c0000100 c00010 # Length 6, distance 3.
  c0000000
  EOI

  : overlap
  : Match that copies the bytes it produces
  :
  $* <'1:1 2:1 c10010001 c0000111 c00000 c0000000' >:'aaaaaaaaaa'

  : length-258
  :
  $* --size <'1:1 2:1 c10010001 c11000101 c00000 c0000000' >'259'

  : length-257
  : Longest length of symbol 284
  :
  $* --size <'1:1 2:1 c10010001 c11000100 5:30 c00000 c0000000' >'258'

  : length-284
  : Symbol 284 with the extra bits that would make length 258, which lies
  : outside its range
  :
  $* <'1:1 2:1 c10010001 c11000100 5:31 c00000 c0000000' 2>>EOE != 0
  error: invalid length 258 for length symbol 284
  EOE

  : window
  : Match at the largest distance, 32768
  :
  $* --tail 3 <<EOI >:'baa'
  1:1 2:1 c10010010 c10010001
  [ c11000101 c00000 ]*127   # 32766 more of 'a'.
  c0000001 c11101 13:8191    # Length 3, distance 32768.
  c0000000
  EOI

  : distance
  : Match reaching back before the start of the data
  :
  $* <'1:1 2:1 c10010001 c0000001 c00001 c0000000' 2>>EOE != 0
  error: invalid distance 2 at output offset 1
  EOE

  : symbol-286
  : Literal/length symbol that never occurs in the data
  :
  $* <'1:1 2:1 c11000110' 2>>EOE != 0
  error: invalid literal/length symbol 286
  EOE

  : symbol-30
  : Distance symbol that never occurs in the data
  :
  $* <'1:1 2:1 c10010001 c0000001 c11110' 2>>EOE != 0
  error: invalid distance symbol 30
  EOE
}}

: dynamic
: Test blocks compressed with dynamic codes
:
{{
  # Header with a literal/length code of 'a' (c0), 256 (c10), and 257
  # (c11), and a single distance code, for distance 1 (c0).
  #
  # Its code length code is 18 (c0), 1 (c10), and 2 (c11), and the code
  # lengths are 97 zeros, 1, 158 zeros, 2, 2, and then the distance code
  # length.
  #
  head = '1:1 2:2 5:1 5:0 4:14
  3:0 3:0 3:1 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:2 3:0 3:2
  c0 7:86 c10 c0 7:127 c0 7:9 c11 c11'

  # As above but with a code length code that also has 0, which leaves the
  # distance code empty: 18 (c0), 1 (c10), 0 (c110), and 2 (c111).
  #
  head0 = '1:1 2:2 5:1 5:0 4:14
  3:0 3:0 3:1 3:3 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:3 3:0 3:2
  c0 7:86 c10 c0 7:127 c0 7:9 c111 c111 c110'

  # Header with the largest code counts, 286 literal/length codes and 32
  # distance codes of length 5 (so the distance codeword is the symbol).
  #
  # Its code length code is 1 (c00), 2 (c01), 18 (c10), 5 (c110), and 16
  # (c111).
  #
  headmax = '1:1 2:2 5:29 5:31 4:14
  3:3 3:0 3:2 3:0 3:0 3:0 3:0 3:0 3:0 3:3 3:0 3:0 3:0 3:0 3:0 3:2 3:0 3:2
  c10 7:86 c00 c10 7:127 c10 7:9 c01 c01 c10 7:17
  c110 c111 2:3 c111 2:3 c111 2:3 c111 2:3 c111 2:3 c110'

  : single-distance
  : Distance code of a single code of length one
  :
  $* <"$head c10 c0 c11 c0 c10" >:'aaaa'

  : unused-distance
  : Unused codeword of a single distance code
  :
  $* <"$head c10 c0 c11 c1" 2>>EOE != 0
  error: invalid distance codeword
  EOE

  : incomplete-distance
  : Single distance code longer than one bit
  :
  $* <"$head c11 c0 c11 c0 c10" 2>>EOE != 0
  error: invalid distance code: incomplete
  EOE

  : no-distance
  : Empty distance code in a block of literals
  :
  $* <"$head0 c0 c10" >:'a'

  : no-distance-match
  : Match in a block with an empty distance code
  :
  $* <"$head0 c0 c11" 2>>EOE != 0
  error: match in block without distance codes
  EOE

  : end-of-block
  : Literal/length code without the end-of-block code
  :
  $* <<EOI 2>>EOE != 0
  1:1 2:2 5:0 5:0 4:14
  3:0 3:0 3:1 3:3 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:3 3:0 3:2
  c0 7:86 c10 c0 7:127 c0 7:9 c110 c10
  EOI
  error: missing end-of-block code
  EOE

  : incomplete-literal
  : Literal/length code of a single code
  :
  $* <<EOI 2>>EOE != 0
  1:1 2:2 5:0 5:0 4:14
  3:0 3:0 3:1 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:2 3:0 3:2
  c0 7:127 c0 7:107 c10 c10 c0
  EOI
  error: invalid literal/length code: incomplete
  EOE

  : over-subscribed-literal
  : Literal/length code of three codes of length one
  :
  $* <<EOI 2>>EOE != 0
  1:1 2:2 5:1 5:0 4:14
  3:0 3:0 3:1 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:0 3:2 3:0 3:2
  c0 7:86 c10 c0 7:127 c0 7:9 c10 c10 c10
  EOI
  error: invalid literal/length code: over-subscribed
  EOE

  : over-subscribed-length
  : Code length code of four codes of length one
  :
  $* <'1:1 2:2 5:0 5:0 4:0 3:1 3:1 3:1 3:1' 2>>EOE != 0
  error: invalid code length code: over-subscribed
  EOE

  : incomplete-length
  : Code length code of a single code
  :
  $* <'1:1 2:2 5:0 5:0 4:0 3:0 3:0 3:1 3:0' 2>>EOE != 0
  error: invalid code length code: incomplete
  EOE

  : empty-length
  : Code length code without codes
  :
  $* <'1:1 2:2 5:0 5:0 4:0 3:0 3:0 3:0 3:0' 2>>EOE != 0
  error: invalid code length code: empty
  EOE

  # The code length code in the repeat tests has 0 (c00), 16 (c01), 17
  # (c10), and 18 (c11).
  #
  : repeat-first
  : Repeat of the previous code length before any
  :
  $* <'1:1 2:2 5:0 5:0 4:0 3:2 3:2 3:2 3:2 c01 2:0' 2>>EOE != 0
  error: code length repeat with no previous length
  EOE

  : repeat-beyond
  : Repeat past the end of the code lengths
  :
  $* <'1:1 2:2 5:0 5:0 4:0 3:2 3:2 3:2 3:2 c11 7:127 c11 7:127' 2>>EOE != 0
  error: code length repeat beyond 258 code lengths
  EOE

  : literal-count
  : Literal/length code count of 287
  :
  $* <'1:1 2:2 5:30 5:0 4:0' 2>>EOE != 0
  error: invalid literal/length code count 287
  EOE

  : largest-counts
  :
  $* <"$headmax c0 c11 c00000 c10" >:'aaaa'

  : largest-counts-symbol-30
  : Distance symbol 30 that has a code but never occurs in the data
  :
  $* <"$headmax c0 c11 c11110" 2>>EOE != 0
  error: invalid distance symbol 30
  EOE
}}

