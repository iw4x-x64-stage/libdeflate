: data
: Test the sequence of blocks
:
{{
  : multiple-blocks
  :
  $* <<EOI >:'hi!'
  1:0 2:0 align 16:2 16:65533 x6869
  1:1 2:1 c01010001 c0000000
  EOI

  : across-blocks
  : Match that reaches back into the previous block
  :
  $* <<EOI >:'abcabc'
  1:0 2:0 align 16:3 16:65532 x616263
  1:1 2:1 c0000001 c00010 c0000000
  EOI

  : block-type
  : Reserved block type
  :
  $* <'1:1 2:3' 2>>EOE != 0
  error: invalid block type 3
  EOE

  : empty
  : No data at all
  :
  $* <'' 2>>EOE != 0
  error: incomplete deflate data
  EOE

  : incomplete
  : Data that ends before the final block does
  :
  $* <'1:1 2:1 c10010001' 2>>EOE != 0
  error: incomplete deflate data
  EOE

  : junk
  : Data followed by another byte
  :
  $* <'1:1 2:1 c10010001 c0000000 align x00' 2>>EOE != 0
  error: junk after deflate data
  EOE
}}

